{
  "name": "saucedemo-bdd-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "BDD test framework for saucedemo.com using Playwright, TypeScript and Cucumber",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --profile smoke",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:parallel": "cross-env PARALLEL=3 cucumber-js",
    "test:db": "cross-env DB_ENABLED=true cucumber-js --profile db",
    "db:check": "tsx scripts/db-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

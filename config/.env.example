# Copy this file to config/.env and change what you need.
# Anything you set in the shell (or in CI) overrides this file.

# --- App under test ---
BASE_URL=https://www.saucedemo.com

# --- Browser ---
# chromium | firefox | webkit
BROWSER=chromium
HEADLESS=true
# Slows every action down (ms). Handy when watching a headed run.
SLOW_MO=0

# --- Timeouts (ms) ---
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000
EXPECT_TIMEOUT=5000
STEP_TIMEOUT=60000

# --- Logging: debug | info | warn | error ---
LOG_LEVEL=info

# --- Runner ---
# Number of parallel workers and retries for failed scenarios
PARALLEL=1
RETRY=0

# --- Database (only used by @db scenarios and npm run db:check) ---
# Placeholder values only. Never commit real credentials.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop
DB_USER=test_user
DB_PASSWORD=change_me
DB_SSL=false
DB_CONNECT_TIMEOUT=5000
DB_QUERY_TIMEOUT=10000
